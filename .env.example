# ============================================================================
# Mentor — Environment Variable Template (§8/§10)
# ----------------------------------------------------------------------------
# This file is a TEMPLATE — it contains NO real secrets and is kept in version control.
# Usage: `cp .env.example .env` → fill in the values. `.env` is git-ignored.
# Setup steps for each service: docs/integrations.md
# ============================================================================

# --- General ---
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3001
# Allowed CORS origins (comma-separated). Unset → dev defaults (web :3000, admin :3002).
# Prod example: CORS_ORIGINS=https://app.mentor.example,https://admin.mentor.example
CORS_ORIGINS=

# --- Database · Postgres + pgvector (single `pg` Pool driver) ---
# Local dev (docker compose, `pnpm db:up`) — host port 5433:
DATABASE_URL=postgres://mentor:mentor@localhost:5433/mentor
# Prod/staging (Neon, EU region): pooled connection string, e.g.
# DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/mentor?sslmode=require

# --- Auth · Own JWT (NestJS) — REQUIRED ---
# Generate: `openssl rand -base64 32`. Refresh tokens are opaque (hashed in DB) → no second secret.
JWT_ACCESS_SECRET=change-me-32-chars-minimum-secret!!
# TTLs in seconds (defaults: access 900 = 15m, refresh 2592000 = 30d)
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
# Google sign-in (Web application OAuth client; redirect URI must match Google Console exactly)
# Local example: http://localhost:3001/v1/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# --- AI · chat + vision providers are both selectable: fake | openai | gemini ---
# fake is dev/test-only; production boot rejects fake AI/vision providers. Disable live AI with
# the runtime `ai.enabled` kill-switch instead of changing the provider.
# Whichever provider + key you set runs (single-key setups work: only OpenAI or only Gemini).
# Gotcha: switching AI_PROVIDER changes the embedding model → run POST /v1/admin/ai/reembed once.
AI_PROVIDER=fake
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.0-flash
# Embed model when AI_PROVIDER=gemini — must support outputDimensionality=1536 (pgvector).
GEMINI_EMBED_MODEL=gemini-embedding-001
# Photo→subject/topic categorize: fake | gemini | openai (fake is dev/test-only)
VISION_PROVIDER=fake
# Object storage: fake | r2. fake writes to .fake-storage/ and is forbidden in production.
# Everything R2 needs lives in the Cloudflare · R2 block below — see docs/core/storage-r2.md.
STORAGE_PROVIDER=fake

# --- Payments (PaymentsPort) ---
# fake = dev/test (no iyzico account needed; forbidden in production — boot fails).
# iyzico = real provider (requires the keys below; Phase 0 paperwork).
PAYMENTS_PROVIDER=fake
# HMAC secret for webhook signature verification (min 16 chars)
PAYMENTS_WEBHOOK_SECRET=change-me-webhook-secret
IYZICO_API_KEY=sandbox-...
IYZICO_SECRET_KEY=sandbox-...
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# --- Cloudflare · R2 (object storage, S3-compatible) ---
# Setup runbook: docs/core/storage-r2.md
# ALL of the six below are required when STORAGE_PROVIDER=r2 — boot fails otherwise.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Two buckets: public serves avatars/, forum-attachments/, content/, vision-board/.
# Private holds mock-exams/ (exam photos are personal data, never publicly readable).
R2_PUBLIC_BUCKET=mentor-public
R2_PRIVATE_BUCKET=mentor-private
# Where the browser reads public objects from. Dev: the bucket's r2.dev Public Development URL
# (https://pub-....r2.dev). Production: a custom domain — r2.dev is rate-limited by design.
R2_PUBLIC_BASE_URL=
# auto | eu. Must match the jurisdiction the buckets were CREATED with: `eu` builds an
# <account>.eu.r2.cloudflarestorage.com endpoint, and a default-jurisdiction bucket 404s there.
# Production is `eu` (render.yaml); use `auto` for throwaway test buckets.
R2_JURISDICTION=auto

# --- Cloudflare · Turnstile (bot/Sybil protection) ---
TURNSTILE_SECRET_KEY=
# Frontend (web/admin) public site key:
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Email · Postmark (transactional) ---
POSTMARK_TOKEN=
POSTMARK_FROM=noreply@mentor.app

# --- Internal cron (Render Cron → POST /v1/internal/cron/*) ---
CRON_SECRET=change-me-cron-secret-min-32-chars!!

# --- Web Push (VAPID) — generate: npx web-push generate-vapid-keys ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@mentor.app

# --- Frontend web push (public VAPID key) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Error monitoring · Sentry ---
SENTRY_DSN=

# Google Ad Manager inventory paths (feature flags remain off until legal/provider setup is complete)
GAM_KNOWLEDGE_ARTICLE_END_AD_UNIT=
GAM_DASHBOARD_REWARDED_COIN_AD_UNIT=

# --- Frontend (web/admin) ---
# API base URL (must be reachable from the browser)
NEXT_PUBLIC_API_URL=http://localhost:3001/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Browser-restricted key; enable Maps JavaScript API + 3D Maps, set referrer restrictions/quotas.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# One-shot official YKS catalogue activation inputs (no code defaults; final guide only)
YKS_OFFICIAL_PREFERENCE_LIMIT=
YKS_PROGRAM_DATASET_SOURCE_URL=
YKS_PROGRAM_DATASET_VERIFIED_AT=
NEXT_PUBLIC_PROFILE_FEEDBACK_URL=
NEXT_PUBLIC_MENTOR_YOUTUBE_URL=
NEXT_PUBLIC_MENTOR_TIKTOK_URL=
NEXT_PUBLIC_MENTOR_INSTAGRAM_URL=
NEXT_PUBLIC_MENTOR_X_URL=
