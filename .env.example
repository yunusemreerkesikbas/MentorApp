# ============================================================================
# Mentor — Environment Variable Template (§8/§10)
# ----------------------------------------------------------------------------
# This file is a TEMPLATE — it contains NO real secrets and is kept in version control.
# Usage: `cp .env.example .env` → fill in the values. `.env` is git-ignored.
# Setup: docs/core/integrations.md; production domains: docs/core/deployment.md.
# ============================================================================

# --- General ---
NODE_ENV=development
# Deployment name: development | staging | production. Unset = follows NODE_ENV (production →
# production). Staging runs NODE_ENV=production, so set APP_ENV=staging there: that unlocks the
# admin "Test ortamı" switches (dev.email.console_enabled prints every email, links included, to
# the API stdout). Never set it to anything but production on production. Kept commented because
# an empty value is rejected.
# APP_ENV=staging
APP_URL=http://localhost:3000
# Admin browser origin, not the API URL (:3001). Used by CORS and admin auth checks.
ADMIN_APP_URL=http://localhost:3002
PORT=3001
# Allowed CORS origins (comma-separated). Blank/unset → APP_URL + ADMIN_APP_URL.
# An explicit list replaces those defaults; include both browser origins. Restart the API after changes.
# Production requires explicit HTTPS APP_URL/CORS origins; localhost/IP origins are rejected.
# Prod: CORS_ORIGINS=https://puhukoc.com,https://admin.puhukoc.com
CORS_ORIGINS=

# --- Database · Postgres + pgvector (single `pg` Pool driver) ---
# Local dev (docker compose, `pnpm db:up`) — host port 5433:
DATABASE_URL=postgres://mentor:mentor@localhost:5433/mentor
# Prod/staging (Neon, EU region): pooled connection string, e.g.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/mentor?sslmode=require
# Production runtime role must not own DB/schema/tables, have BYPASSRLS/SUPERUSER/CREATEROLE,
# or membership in privileged/owner roles. Use separate credentials for direct migrations.
# Set DATABASE_MIGRATION_URL only in the operator/pre-deploy migration process. Production
# db:migrate requires it; the API runtime does not. Do not add it to a Free API service.
# DATABASE_MIGRATION_URL=postgresql://migration_owner:password@ep-xxx.eu-central-1.aws.neon.tech/mentor?sslmode=require

# --- Auth · Own JWT (NestJS) — REQUIRED ---
# Generate: `openssl rand -base64 32`. Refresh tokens are opaque (hashed in DB) → no second secret.
JWT_ACCESS_SECRET=change-me-32-chars-minimum-secret!!
# Independent HMAC secret for hashed IP/email rate counters (required in every environment).
AUTH_RATE_LIMIT_SECRET=change-me-auth-rate-limit-secret-32-chars!!
# Required in production. Set the SAME value in a Cloudflare request-header transform rule that
# OVERWRITES x-mentor-origin-secret for the API hostname. Never expose it to browser code.
# EDGE_ORIGIN_SECRET=
# TTLs in seconds (defaults: access 900 = 15m, refresh 2592000 = 30d)
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
# Google sign-in (Web application OAuth client; redirect URI must match Google Console exactly)
# Local example: http://localhost:3001/v1/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Private API-only invited addresses, comma-separated. Blank permits nobody in pilot mode.
# Uses shared email normalization; no domains/wildcards. Never put real addresses in this template.
# Toggle signup.pilot.enabled and cap signup.pilot.max_invited_emails in the config registry.
PILOT_INVITED_EMAILS=

# --- SMS phone verification (Netgsm transport; application-owned OTP) ---
# Disabled until sender approval, OTP package, restricted API subuser and carrier pilot are ready.
SMS_PROVIDER=disabled
# Required together when SMS_PROVIDER=netgsm. Use independent random secrets of >=32 characters.
# NETGSM_USERCODE=
# NETGSM_API_PASSWORD=
# NETGSM_MSGHEADER=
# PHONE_OTP_SECRET=
# PHONE_FINGERPRINT_SECRET=
# Runtime identity.phone.enabled is also off by default.
# mentorship.phone_verification_required and payments.trial.phone_verification_required
# are separate audited registry flags, both false by default. See docs/core/integrations.md.
# Keep fingerprint key stable across the 12-month trial retention window; blind rotation resets
# anti-abuse matching. Never print OTPs, phones, provider passwords or these secrets.

# --- AI · chat + vision providers: disabled | fake | openai | gemini ---
# For a credential-free closed deployment, set BOTH providers to disabled and omit both keys.
# This forces ai.enabled off; changing a DB flag cannot reopen AI without a new deployment.
# fake remains dev/test-only. Real providers require their keys and the runtime ai.enabled flag.
# Whichever provider + key you set runs (single-key setups work: only OpenAI or only Gemini).
# Gotcha: switching AI_PROVIDER changes the embedding model → run POST /v1/admin/ai/reembed once.
AI_PROVIDER=fake
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.0-flash
# Embed model when AI_PROVIDER=gemini — must support outputDimensionality=1536 (pgvector).
GEMINI_EMBED_MODEL=gemini-embedding-001
# Photo→subject/topic categorize: disabled | fake | gemini | openai
VISION_PROVIDER=fake
# Object storage: fake | r2. fake writes to .fake-storage/ and is forbidden in production.
# Everything R2 needs lives in the Cloudflare · R2 block below — see docs/core/storage-r2.md.
STORAGE_PROVIDER=fake
STORAGE_ACCESS_MODE=direct
# Bounded trial only: independent 32+ character local media-signing material, not an AI key.
# Never reuse auth/edge/cron keys; never expose this value through NEXT_PUBLIC_*.
MEDIA_READ_SECRET=

# --- Payments (PaymentsPort) ---
# fake = dev/test (no iyzico account needed; forbidden in production — boot fails).
# iyzico = real provider (requires the keys below; Phase 0 paperwork).
PAYMENTS_PROVIDER=fake
# HMAC secret for webhook signature verification (min 16 chars)
PAYMENTS_WEBHOOK_SECRET=change-me-webhook-secret
IYZICO_API_KEY=sandbox-...
IYZICO_SECRET_KEY=sandbox-...
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# --- Cloudflare · R2 (object storage, S3-compatible) ---
# Setup runbook: docs/core/storage-r2.md
# ALL of the six below are required when STORAGE_PROVIDER=r2 — boot fails otherwise.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Logical public prefixes: avatars/, forum-attachments/, content/.
# Private prefixes: mock-exams/, notebook/, vision-board/.
# Bounded trial: BOTH buckets stay provider-private; no r2.dev/custom-domain access.
R2_PUBLIC_BUCKET=mentor-public
R2_PRIVATE_BUCKET=mentor-private
# direct: public bucket/custom-domain base. bounded: actual API HTTPS origin followed by
# /v1/storage/media/public. Bounded private reads use the same API origin and a short grant.
R2_PUBLIC_BASE_URL=
# auto | eu. Must match the jurisdiction the buckets were CREATED with: `eu` builds an
# <account>.eu.r2.cloudflarestorage.com endpoint, and a default-jurisdiction bucket 404s there.
# Production is `eu` (render.yaml); use `auto` for throwaway test buckets.
R2_JURISDICTION=auto

# --- Cloudflare · Turnstile (bot/Sybil protection) ---
# Production requires the secret and expected hostname matching APP_URL. Missing keys fail boot.
TURNSTILE_SECRET_KEY=
# Configure when using real Turnstile; omit this line for unconfigured local development.
# Production: TURNSTILE_EXPECTED_HOSTNAME=puhukoc.com
TURNSTILE_EXPECTED_ACTION=signup
TURNSTILE_VERIFY_TIMEOUT_MS=5000

# Default: production admin requires Access. Explicit disabled denies ALL admin API/auth routes.
# Free core-only trial: ADMIN_ACCESS_MODE=disabled; do not deploy the admin frontend.
ADMIN_ACCESS_MODE=cloudflare
# Required in production cloudflare mode; omit/unset these in disabled mode (not empty strings).
# The API verifies Access JWTs on /v1/admin/** and /v1/auth/admin/**, including direct origins.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=
# Frontend (web/admin) public site key:
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Email · Resend (transactional) ---
RESEND_API_KEY=
RESEND_FROM=noreply@puhukoc.com

# --- Internal cron (Render Cron → POST /v1/internal/cron/*) ---
CRON_SECRET=change-me-cron-secret-min-32-chars!!

# --- Web Push (VAPID) — generate: npx web-push generate-vapid-keys ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://puhukoc.com

# --- Frontend web push (public VAPID key) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Error monitoring · Sentry ---
SENTRY_DSN=

# Google Ad Manager inventory paths (feature flags remain off until legal/provider setup is complete)
GAM_KNOWLEDGE_ARTICLE_END_AD_UNIT=
GAM_DASHBOARD_REWARDED_COIN_AD_UNIT=
# Local API only: forces official Google DISPLAY test inventory, simulates TR when no edge
# country exists, and bypasses display rollout flags. Premium/STAFF and content checks remain.
# Requires NODE_ENV=development, APP_ENV unset/development, and HTTP loopback APP_URL.
# Never enable on staging/production (startup rejects it). No publisher revenue is generated.
ADS_LOCAL_TEST_ENABLED=false
# Official Google sample DISPLAY units are blocked in production even with local test mode off.
# Web server only: real Google publisher ID (pub- + 16 digits), blank keeps /ads.txt unpublished.
# Never copy the staging test inventory IDs into production.
GOOGLE_ADS_PUBLISHER_ID=

# --- Frontend (web/admin) ---
# API base URL (must be reachable from the browser)
NEXT_PUBLIC_API_URL=http://localhost:3001/v1
# Production: https://api.puhukoc.com/v1
# Exact comma-separated HTTPS origins for media. Bounded trial needs only its API origin.
# Runtime web setting; empty permits only same-origin/API media. No paths or wildcards.
# Runtime web setting; empty permits only same-origin/API media. No paths or wildcards.
# Note: @aws-sdk/client-s3 uses virtual-hosted style by default, so private signed GET URLs
# resolve to https://<R2_PRIVATE_BUCKET>.<R2_ACCOUNT_ID>[.eu].r2.cloudflarestorage.com.
# Example (dev): WEB_CSP_STORAGE_ORIGINS=https://pub-xxx.r2.dev,https://mentor-private.<account_id>.r2.cloudflarestorage.com
# Example (legacy direct): WEB_CSP_STORAGE_ORIGINS=https://media.puhukoc.com,https://puhu-prod-private.<account_id>.eu.r2.cloudflarestorage.com
# Bounded trial: leave empty for same-origin/API media; do not allow bucket origins.
WEB_CSP_STORAGE_ORIGINS=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: https://puhukoc.com. See docs/core/deployment.md.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Browser-restricted key; enable Maps JavaScript API + 3D Maps, set referrer restrictions/quotas.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# One-shot official YKS catalogue activation inputs (no code defaults; final guide only)
YKS_OFFICIAL_PREFERENCE_LIMIT=
YKS_PROGRAM_DATASET_SOURCE_URL=
YKS_PROGRAM_DATASET_VERIFIED_AT=
NEXT_PUBLIC_PROFILE_FEEDBACK_URL=
NEXT_PUBLIC_MENTOR_YOUTUBE_URL=
NEXT_PUBLIC_MENTOR_TIKTOK_URL=
NEXT_PUBLIC_MENTOR_INSTAGRAM_URL=
NEXT_PUBLIC_MENTOR_X_URL=
# App Store / Google Play listings: the web hands buyers there while payments.web.redirect_to_mobile is on (build-time)
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
