# ============================================================================
# Mentor — Environment Variable Template (§8/§10)
# ----------------------------------------------------------------------------
# This file is a TEMPLATE — it contains NO real secrets and is kept in version control.
# Usage: `cp .env.example .env` → fill in the values. `.env` is git-ignored.
# Setup steps for each service: docs/integrations.md
# ============================================================================

# --- General ---
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3001
# Allowed CORS origins (comma-separated). Unset → dev defaults (web :3000, admin :3002).
# Prod example: CORS_ORIGINS=https://app.mentor.example,https://admin.mentor.example
CORS_ORIGINS=

# --- Database · Postgres + pgvector (single `pg` Pool driver) ---
# Local dev (docker compose, `pnpm db:up`) — host port 5433:
DATABASE_URL=postgres://mentor:mentor@localhost:5433/mentor
# Prod/staging (Neon, EU region): pooled connection string, e.g.
# DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/mentor?sslmode=require

# --- Auth · Own JWT (NestJS) — REQUIRED ---
# Generate: `openssl rand -base64 32`. Refresh tokens are opaque (hashed in DB) → no second secret.
JWT_ACCESS_SECRET=change-me-32-chars-minimum-secret!!
# TTLs in seconds (defaults: access 900 = 15m, refresh 2592000 = 30d)
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
# Google sign-in (Web application OAuth client; redirect URI must match Google Console exactly)
# Local example: http://localhost:3001/v1/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# --- AI · text = OpenAI (GPT-5), vision = Gemini Flash ---
AI_PROVIDER=fake
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.0-flash
# Photo→subject categorize adapters (dev defaults: fake / fake)
VISION_PROVIDER=fake
STORAGE_PROVIDER=fake
# Optional public base for R2 read URLs when STORAGE_PROVIDER=r2
R2_PUBLIC_BASE_URL=

# --- Payments (PaymentsPort) ---
# fake = dev/test (no iyzico account needed; forbidden in production — boot fails).
# iyzico = real provider (requires the keys below; Phase 0 paperwork).
PAYMENTS_PROVIDER=fake
# HMAC secret for webhook signature verification (min 16 chars)
PAYMENTS_WEBHOOK_SECRET=change-me-webhook-secret
IYZICO_API_KEY=sandbox-...
IYZICO_SECRET_KEY=sandbox-...
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# --- Cloudflare · R2 (object storage, S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mentor-uploads

# --- Cloudflare · Turnstile (bot/Sybil protection) ---
TURNSTILE_SECRET_KEY=
# Frontend (web/admin) public site key:
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Email · Postmark (transactional) ---
POSTMARK_TOKEN=
POSTMARK_FROM=noreply@mentor.app

# --- Internal cron (Render Cron → POST /v1/internal/cron/*) ---
CRON_SECRET=change-me-cron-secret-min-32-chars!!

# --- Web Push (VAPID) — generate: npx web-push generate-vapid-keys ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@mentor.app

# --- Frontend web push (public VAPID key) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Error monitoring · Sentry ---
SENTRY_DSN=

# --- Frontend (web/admin) ---
# API base URL (must be reachable from the browser)
NEXT_PUBLIC_API_URL=http://localhost:3001/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PROFILE_FEEDBACK_URL=
NEXT_PUBLIC_MENTOR_YOUTUBE_URL=
NEXT_PUBLIC_MENTOR_TIKTOK_URL=
NEXT_PUBLIC_MENTOR_INSTAGRAM_URL=
NEXT_PUBLIC_MENTOR_X_URL=
