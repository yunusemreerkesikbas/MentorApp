{
  "name": "@mentor/validation",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas — shared by frontend + backend (§8). Single validation source.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "clean": "rimraf dist .turbo tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mentor/config": "workspace:*",
    "@mentor/types": "workspace:*",
    "eslint": "^9.17.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}
