{
  "name": "@mentor/api",
  "version": "0.0.0",
  "private": true,
  "description": "Mentor backend — NestJS modular monolith (§8). Single API, /v1, serves web+mobile.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:live:openai": "vitest run --config vitest.live.config.ts",
    "test:eval:openai": "vitest run --config vitest.eval.config.ts",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "openapi:export": "ts-node -T scripts/export-openapi.ts",
    "seed:forum": "ts-node -T scripts/seed-forum.ts",
    "seed:analysis-demo": "ts-node -T scripts/seed-analysis-demo.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "clean": "rimraf dist .turbo",
    "seed:universities": "node scripts/build-university-seed.mjs",
    "seed:geocode": "node scripts/geocode-universities.mjs",
    "seed:programs": "node scripts/import-programs.mjs",
    "seed:kpss": "node scripts/build-kpss-seed.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1071.0",
    "@aws-sdk/s3-request-presigner": "^3.1071.0",
    "@mentor/core": "workspace:*",
    "@mentor/types": "workspace:*",
    "@mentor/validation": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.3.0",
    "@sentry/nestjs": "^8.47.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.0.0",
    "marked": "^18.0.6",
    "nestjs-i18n": "^10.5.0",
    "nestjs-pino": "^4.1.0",
    "pg": "^8.13.1",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.17.6",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@mentor/config": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.10.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.8",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.0.0",
    "rimraf": "^6.0.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "unplugin-swc": "^1.5.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8",
    "xlsx": "^0.18.5"
  }
}
