{
  "name": "@mentor/web",
  "version": "0.0.0",
  "private": true,
  "description": "Mentor B2C web — Next.js (responsive + SEO wedge). The main MVP product.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "build:map": "node scripts/build-turkey-map.mjs",
    "assets:check:achievements": "node scripts/validate-achievement-assets.mjs",
    "test:assets:achievements": "node --test scripts/achievement-asset-validator.spec.mjs",
    "start": "next start --port 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "clean": "rimraf .next .turbo"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.1",
