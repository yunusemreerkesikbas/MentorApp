    "@lexical/markdown": "^0.49.0",
    "@lexical/react": "^0.49.0",
    "@lexical/rich-text": "^0.49.0",
    "@lexical/selection": "^0.49.0",
    "@lottiefiles/dotlottie-react": "^0.19.15",
    "@mentor/api-client": "workspace:*",
    "@mentor/types": "workspace:*",
    "@mentor/ui": "workspace:*",
    "@mentor/validation": "workspace:*",
    "@nivo/core": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "emoji-picker-react": "^4.19.1",
    "framer-motion": "^12.40.0",
    "lexical": "^0.49.0",
    "lucide-react": "^1.21.0",
    "next": "16.2.7",
    "next-intl": "^3.26.0",
    "perfect-freehand": "^1.2.3",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/google.maps": "^3.65.4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "d3-geo": "^3.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "rimraf": "^6.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
